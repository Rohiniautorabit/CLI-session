<apex:page standardController="Job__c" extensions="practicsvs1" >
<!-- Begin Default Content REMOVE THIS -->
<apex:form>
    <apex:pageBlock>
      <apex:pageMessages id="msg"/>
      
           <apex:pageBlockSection title="Job details" collapsible="true" columns="1">
             <apex:inputField value="{!jobstatus.JobStatus__c}" label="Job Status">
               <apex:actionSupport event="onchange" action="{!conditionaldisplay}" rerender="statusSection,msg"/>
             </apex:inputField>
            </apex:pageBlockSection>
            <apex:outputPanel id="statusSection">
            <apex:pageBlockSection title="Current Status" columns="1" rendered="{!display}">
                <apex:inputField value="{!jobstatus.Interviewed_by__c}" label="Interviewed by"/>
             </apex:pageBlockSection>
            </apex:outputPanel>
        
            <apex:pageBlockButtons location="bottom">
              <apex:commandButton  value="Save" action="{!saverecord}" rerender="msg,statusSection" /> 
              </apex:pageBlockButtons> 
        
    </apex:pageBlock>
        
</apex:form>
<!-- End Default Content REMOVE THIS -->
</apex:page>