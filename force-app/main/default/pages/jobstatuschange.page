<apex:page standardController="Job__c" extensions="jobchangecontroller" >
<!-- Begin Default Content REMOVE THIS -->
<apex:form>
    
    <apex:pageBlock>
        <!-- Page Block to hold the content -->
        <apex:pageBlockSection title="Job Status Change" columns="1">
            <apex:inputField value="{!jobstatus.JobStatus__c}" label="Job">
            <apex:actionSupport event="onchange" action="{!fetchCurrentStatus}"   rerender="statusSection"/>
            </apex:inputField>
        </apex:pageBlockSection>
        <!-- Page Block to hold the content -->
          <apex:outputPanel id="statusSection">
            <apex:pageBlockSection title="Current Status" columns="1" rendered="{!showfeld}">
                <apex:inputField value="{!jobstatus.Interviewed_by__c}" label="Current Status"/>
            </apex:pageBlockSection>
            </apex:outputPanel>

            <apex:commandButton value="save" action="{!saverecord}"/>  
    </apex:pageBlock>

</apex:form>
<!-- End Default Content REMOVE THIS -->
</apex:page>
